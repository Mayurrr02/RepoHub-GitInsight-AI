# ==========================================
# RepoHub Environment Configuration
# ==========================================

# Database & Cache (Auto-injected if using Railway PostgreSQL & Redis)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/railway
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET_KEY=generate-a-secure-random-secret-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# GitHub OAuth Application
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=https://your-backend.up.railway.app/api/v1/auth/github/callback

# Frontend URL for CORS and OAuth redirect
FRONTEND_URL=https://your-frontend.vercel.app

# AI / Gemini Intelligence
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
